# Data and generated research artefacts
data/raw/
data/processed/
data/external/
.local_data/
BenchmarkDatasets*.zip
data/raw/fi2010/
data/processed/fi2010/
runs/
outputs/
checkpoints/
wandb/
mlruns/
# Ignore large prediction artefacts but allow the rest of the real
# FI-2010 evidence directories to be tracked alongside the empirical
# report. The intermediate ablation and systems child experiment trees
# are dominated by regenerable predictions, so they are ignored as a
# whole.
experiments/fi2010_midprice_h10/predictions.csv
experiments/fi2010_midprice_h10/predictions.parquet
experiments/fi2010_neural_full_grid/runs/
experiments/fi2010_neural_proper_training_subset/runs/
experiments/fi2010_neural_proper_training_subset_v2/runs/
# Hamilton proper-training neural benchmark (this phase): per-cell timing and
# array task outputs are regenerable and storage-heavy; only retained,
# consolidated summaries are committed deliberately, never the raw task trees.
experiments/fi2010_proper_neural_hamilton_timing/
experiments/fi2010_proper_neural_hamilton_tasks/
# Broader proper-training neural grid (separate from the published subset_v2 so
# existing SSL-v2 baseline evidence is never mutated): ignore the heavy per-run
# tree and predictions; its top-level aggregate summaries are committed
# deliberately, exactly as for the existing subset_v2 directory.
experiments/fi2010_neural_proper_training_broader/runs/
experiments/fi2010_feature_ablations/runs/
experiments/fi2010_feature_ablations/features/
# Cached feature matrices and per-run row-level predictions are regenerable
# and must never be tracked, regardless of which experiment tree they live in.
experiments/**/features/
experiments/**/predictions.csv
experiments/**/predictions.parquet
# Extracted raw FI-2010 tree (regenerable by unzipping BenchmarkDatasets.zip).
data/raw/fi2010/extracted/
# Local pre-deletion archive (never commit).
_local_archive_before_delete/
experiments/fi2010_midprice_h10_ablations/experiments/
experiments/fi2010_midprice_h10_systems/child_experiments/
experiments/paper_experiment_*/
experiments/paper_ablation_*/
experiments/system_benchmark_*/
reports/evidence_pack/[c]v_bullets_*.md

# Synthetic LOB extension: keep committed summaries/samples, ignore full dumps
reports/synthetic_lob_extension/synthetic_events_full.*
reports/synthetic_lob_extension/synthetic_snapshots_full.*
reports/synthetic_lob_extension/*_full.parquet
reports/synthetic_lob_extension_*/

# Binance L2 extension: keep committed summaries/figures, ignore raw captures
data/binance_l2_captures/
reports/binance_l2_extension/*_full.*
reports/binance_l2_extension/raw_*.json
reports/binance_l2_extension/raw_*.jsonl
reports/binance_l2_extension_*/

# Model artefacts and large generated files
*.ckpt
*.pt
*.pth
*.onnx
*.joblib
*.pkl

# Logs
*.log
logs/
